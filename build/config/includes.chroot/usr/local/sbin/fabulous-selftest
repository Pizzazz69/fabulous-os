#!/bin/sh
# Fabulous OS self-check. Prints facts about the running system to the first
# serial port, where the build servers' test machine records them.
# Changes nothing, except in "full" mode, where it downloads virus signatures
# (test machines only) to prove the scanner really detects something.
# In "gemma" and "full" modes it also asks Gemma one question, as an ordinary user.
mode=$(cat "$CREDENTIALS_DIRECTORY/fabulous.selftest" 2>/dev/null || echo basic)
exec > /dev/ttyS0 2>&1
echo "=== FABULOUS SELFTEST BEGIN (mode: $mode) ==="
. /etc/os-release
echo "system: $PRETTY_NAME"
echo "started from: $([ -e /run/live/medium ] && echo stick || echo installed-disk)"
echo "kernel: $(uname -r)"
ls -l /etc/os-release /usr/lib/os-release* 2>&1
echo "timezone: $(cat /etc/timezone 2>/dev/null)  language: ${LANG:-$(grep -h ^LANG= /etc/default/locale 2>/dev/null)}"
echo "--- secure boot"
mokutil --sb-state
echo "--- firewall"
ufw status verbose
echo "--- network services listening (empty = none)"
ss -H -tuln
echo "--- probe"
fabulous-probe --explain
echo "--- rules"
fabulous-probe --stdout > /run/fabulous-selftest-profile.json && fabulous-rules /run/fabulous-selftest-profile.json
echo "--- disks"
lsblk -o NAME,RO,RM,TRAN,SIZE,TYPE,FSTYPE,MOUNTPOINT
echo "--- memory"
free -m
echo "--- services that failed to start (empty = none)"
systemctl --failed --no-legend
echo "--- scanner"
clamscan --version
systemctl is-enabled clamav-daemon 2>&1 | sed 's/^/always-on scanner service: /'
systemctl is-active clamav-freshclam 2>&1 | sed 's/^/signature updater: /'
echo "--- gemma"
ls -l /usr/share/fabulous/models/ /opt/fabulous-gemma/bin/llama-server 2>&1
runuser -u nobody -- /usr/local/bin/fabulous-gemma --isolation 2>&1
echo "=== FABULOUS SELFTEST BASIC DONE ==="
if [ "$mode" = gemma ] || [ "$mode" = full ]; then
    echo "--- gemma answers a question (as an ordinary user)"
    runuser -u nobody -- timeout 1200 /usr/local/bin/fabulous-gemma \
        --ask "Why is the sky blue? Answer in about 50 words." --max-tokens 150 2>&1
    echo "gemma exit code: $?"
    m=/usr/share/fabulous/test-media
    echo "--- gemma looks at a picture (a red circle, a blue square, the words FABULOUS 42)"
    runuser -u nobody -- timeout 1800 /usr/local/bin/fabulous-gemma \
        --ask "What does this picture show? Include any writing." --picture $m/shapes.png --max-tokens 120 2>&1 \
        | sed 's/^answer:/picture answer:/'
    echo "--- gemma listens to a recording (The train to London leaves at half past nine on Tuesday morning.)"
    runuser -u nobody -- timeout 1800 /usr/local/bin/fabulous-gemma \
        --ask "Write down exactly what is said in this recording." --recording $m/speech.wav --max-tokens 60 2>&1 \
        | sed 's/^answer:/recording answer:/'
    echo "--- network services listening now, with the program behind each (empty = none)"
    ss -H -tulnp
    echo "=== FABULOUS SELFTEST GEMMA DONE ==="
fi
if [ "$mode" = full ]; then
    echo "--- scanner detection test"
    systemctl start fabulous-signatures.service; echo "signature fetch exit code: $?"
    ls -l /var/lib/clamav
    d=$(mktemp -d)
    # The standard harmless antivirus test file (EICAR), assembled here so that
    # no copy of it sits in the image.
    printf '%s%s' 'X5O!P%@AP[4\PZX54(P^)7CC)7}$EICAR-STANDARD-' 'ANTIVIRUS-TEST-FILE!$H+H*' > "$d/eicar.com"
    echo "clean text" > "$d/clean.txt"
    timeout 600 clamscan --no-summary "$d" 2>&1 | grep -a -v "Loading:"
    rm -rf "$d"
    echo "=== FABULOUS SELFTEST FULL DONE ==="
fi
