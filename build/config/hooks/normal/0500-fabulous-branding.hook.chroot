#!/bin/sh
# Name the system "Fabulous OS" while staying a Debian derivative.
set -e

# os-release: diverted so Debian's base-files updates do not overwrite it.
# ID stays "debian" on purpose: Debian's signed GRUB (Secure Boot) expects its
# files under EFI/debian, and tools derive that folder name from ID.
dpkg-divert --add --no-rename --divert /usr/lib/os-release.debian /usr/lib/os-release
cp /usr/lib/os-release /usr/lib/os-release.debian
cat > /usr/lib/os-release <<'EOT'
PRETTY_NAME="Fabulous OS 0.1"
NAME="Fabulous OS"
VERSION_ID="13"
VERSION="0.1 (based on Debian 13 trixie)"
VERSION_CODENAME=trixie
ID=debian
HOME_URL="https://github.com/Pizzazz69/fabulous-os"
EOT
# Build 5's self-check showed the running system still calling itself Debian, so
# the name is also placed directly at /etc/os-release, which every program reads first.
rm -f /etc/os-release
cp /usr/lib/os-release /etc/os-release
ls -l /etc/os-release /usr/lib/os-release*
grep -q 'Fabulous OS' /etc/os-release || echo "FABULOUS-WARNING: system name not set"

# Installer: ask "are you sure?" before anything is erased (Debian's setting starts at once),
# and start from London rather than New York for place, clock and date style.
cs=/etc/calamares/settings.conf
if [ -f "$cs" ]; then
    if grep -q '^prompt-install:' "$cs"; then sed -i 's/^prompt-install:.*/prompt-install: true/' "$cs"
    else printf '\nprompt-install: true\n' >> "$cs"; fi
else
    echo "FABULOUS-WARNING: $cs not found; installer erases without asking"
fi
# Start-up files for an external drive (see /usr/local/sbin/fabulous-grub-install).
chmod 0755 /usr/local/sbin/fabulous-grub-install
bl=/etc/calamares/modules/bootloader.conf
if [ -f "$bl" ]; then
    if grep -q '^grubInstall:' "$bl"; then sed -i 's|^grubInstall:.*|grubInstall: "/usr/local/sbin/fabulous-grub-install"|' "$bl"
    else printf '\ngrubInstall: "/usr/local/sbin/fabulous-grub-install"\n' >> "$bl"; fi
    # Debian's signed shim must stay as the removable-drive start-up file. The installer's own
    # "fallback" copy would overwrite it with GRUB, which Secure Boot refuses (seen in build 7).
    if grep -q '^installEFIFallback:' "$bl"; then sed -i 's/^installEFIFallback:.*/installEFIFallback: false/' "$bl"
    else printf 'installEFIFallback: false\n' >> "$bl"; fi
    echo "--- $bl"; grep -v -e '^#' -e '^$' "$bl"
else
    echo "FABULOUS-WARNING: installer start-up settings not found; an external drive may not start on its own"
fi
# Later GRUB updates on the installed system keep to the same two rules.
printf '%s\n' "grub-efi-amd64 grub2/force_efi_extra_removable boolean true" \
              "grub-efi-amd64 grub2/update_nvram boolean false" | debconf-set-selections \
    || echo "FABULOUS-WARNING: GRUB update settings not stored"

grep -q 'zone: London' /etc/calamares/modules/locale.conf 2>/dev/null \
    || echo "FABULOUS-WARNING: installer still starts in New York"

# Installer pictures and wording (made from the mandala by the build; "based on Debian" is on the picture).
bd=/etc/calamares/branding/debian
for pair in "fabulous-logo.png:debian-logo.png" "fabulous-welcome.png:welcome.png" "fabulous-welcome.png:slide1.png"; do
    src=/usr/share/fabulous/branding/${pair%%:*}; dst=$bd/${pair##*:}
    if [ -f "$src" ] && [ -f "$dst" ]; then cp "$src" "$dst"
    else echo "FABULOUS-WARNING: installer picture ${pair##*:} not replaced"; fi
done
if [ -f $bd/show.qml ]; then sed -i 's/Debian GNU\/Linux/Fabulous OS/g' $bd/show.qml
else echo "FABULOUS-WARNING: installer slideshow text not found"; fi

# Log-in screen: the mandala instead of Debian's picture.
found=0
for t in /usr/share/sddm/themes/*/; do
    [ -f "$t/theme.conf" ] || continue
    printf '[General]\ntype=image\nbackground=/usr/share/wallpapers/Fabulous/mandala.png\n' > "$t/theme.conf.user"
    found=1
done
[ "$found" = 1 ] || echo "FABULOUS-WARNING: log-in screen picture not replaced"

# The app store is shown as "App Store".
ds=/usr/share/applications/org.kde.discover.desktop
if [ -f "$ds" ]; then
    dpkg-divert --add --rename --divert "$ds.debian" "$ds"
    sed -e '/^Name\[/d' -e 's/^Name=.*/Name=App Store/' "$ds.debian" > "$ds"
else
    echo "FABULOUS-WARNING: app store menu entry not found"
fi

# Installer wording. bootloaderEntryName is deliberately left as Debian (Secure Boot folder name).
desc=/etc/calamares/branding/debian/branding.desc
if [ -f "$desc" ]; then
    sed -i -E '/^[[:space:]]*(productName|shortProductName|versionedName|shortVersionedName):/ s/Debian( GNU\/Linux)?/Fabulous OS/' "$desc"
    grep -q 'Fabulous OS' "$desc" || echo "FABULOUS-WARNING: installer still says Debian"
else
    echo "FABULOUS-WARNING: $desc not found; installer still says Debian"
fi
# Every "Install Debian" label (menu entry, desktop icon script) becomes "Install Fabulous OS".
found=$(grep -rlI "Install Debian" /usr/share/applications /usr/bin /usr/sbin /etc/skel /etc/calamares /usr/share/calamares /lib/live /usr/lib/live 2>/dev/null || true)
if [ -n "$found" ]; then
    echo "$found" | while read -r f; do sed -i 's/Install Debian/Install Fabulous OS/g' "$f"; echo "relabelled $f"; done
else
    echo "FABULOUS-WARNING: no Install Debian label found to rename"
fi

# Default panel: Windows 11 style, icons in the centre.
tpl=/usr/share/plasma/layout-templates/org.kde.plasma.desktop.defaultPanel/contents/layout.js
if [ -f "$tpl" ]; then
    dpkg-divert --add --rename --divert "$tpl.debian" "$tpl"
    cp /usr/share/fabulous/panel-layout.js "$tpl"
else
    echo "FABULOUS-WARNING: default panel template not found; taskbar not centred"
fi

chmod 0755 /usr/local/bin/fabulous-probe /usr/local/bin/fabulous-rules 2>/dev/null || true
