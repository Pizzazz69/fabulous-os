#!/bin/sh
# Gemma, the assistant that runs on this computer. Failures are reported as
# FABULOUS-WARNING, not hidden. The model file and the program that runs it are
# put into the image tree by the build (see models.lock and build/llama.lock).
set -e
d=/opt/fabulous-gemma/bin
chmod 0755 /usr/local/bin/fabulous-gemma || echo "FABULOUS-WARNING: Gemma's window program is missing"
if [ -x "$d/llama-server" ]; then
    LD_LIBRARY_PATH=$d "$d/llama-server" --version \
        || echo "FABULOUS-WARNING: the program that runs Gemma does not start in Debian 13"
    [ -f "$d/libggml-cpu-sse42.so" ] || echo "FABULOUS-WARNING: no Gemma engine for processors without AVX (the Beelink)"
else
    echo "FABULOUS-WARNING: the program that runs Gemma is not in the image"
fi
ls -l /usr/share/fabulous/models/ 2>&1 || true
ls /usr/share/fabulous/models/*.gguf >/dev/null 2>&1 || echo "FABULOUS-WARNING: no Gemma model in the image"
ls /usr/share/fabulous/models/*mmproj*.gguf >/dev/null 2>&1 || echo "FABULOUS-WARNING: Gemma's add-on for pictures and recordings is not in the image"
python3 -c "import PyQt6.QtWidgets" || echo "FABULOUS-WARNING: Gemma's window cannot open (PyQt6 missing)"
command -v unshare >/dev/null || echo "FABULOUS-WARNING: Gemma cannot be cut off from the network (unshare missing), so it will refuse to start"
# Licences: Gemma is Apache 2.0; llama.cpp's own licence files are placed by the build.
mkdir -p /usr/share/doc/fabulous-gemma
cp /usr/share/common-licenses/Apache-2.0 /usr/share/doc/fabulous-gemma/Gemma-LICENSE-Apache-2.0 \
    || echo "FABULOUS-WARNING: Gemma's licence text not shipped"
ls -l /usr/share/doc/fabulous-gemma/
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
