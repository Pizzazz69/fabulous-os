#!/bin/sh
# Firewall and virus scanner. Failures are reported as FABULOUS-WARNING, not hidden.
set -e
export DEBIAN_FRONTEND=noninteractive

# Firewall: on at every start, in the stick session and in the installed system.
# ufw's defaults are: refuse everything incoming, allow everything outgoing.
if [ -f /etc/ufw/ufw.conf ]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
    sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
    systemctl enable ufw.service || echo "FABULOUS-WARNING: could not enable the firewall service"
    grep -q '^ENABLED=yes' /etc/ufw/ufw.conf || echo "FABULOUS-WARNING: firewall not switched on"
else
    echo "FABULOUS-WARNING: ufw not installed; no firewall"
fi

# Firewall page in System Settings.
apt-get install -y plasma-firewall || echo "FABULOUS-WARNING: plasma-firewall not installed; no firewall settings page"

# Virus scanner, scan-on-request only. No always-on scanning service (clamav-daemon):
# it would hold over 1 GB of memory.
if apt-get install -y --no-install-recommends clamav clamav-freshclam; then
    # No background downloading (David, 13 November): signatures are fetched when the
    # Virus Scanner is opened, by fabulous-signatures.service.
    systemctl disable clamav-freshclam.service 2>/dev/null || true
    systemctl mask clamav-freshclam.service || echo "FABULOUS-WARNING: background signature updater not switched off"
    sed -i 's/^NotifyClamd/#NotifyClamd/' /etc/clamav/freshclam.conf 2>/dev/null || true
else
    echo "FABULOUS-WARNING: ClamAV not installed"
fi
# A window for the scanner, if Debian 13 still carries it.
apt-get install -y clamtk || echo "FABULOUS-WARNING: clamtk not installed; scanner has no window yet"

apt-get install -y kdialog || echo "FABULOUS-WARNING: kdialog not installed; no 'getting signatures' message"
ct=/usr/share/applications/clamtk.desktop
if [ -f "$ct" ]; then
    dpkg-divert --add --rename --divert "$ct.debian" "$ct"
    sed 's|^Exec=clamtk|Exec=/usr/local/bin/fabulous-virus-scanner|' "$ct.debian" > "$ct"
    grep -q fabulous-virus-scanner "$ct" || echo "FABULOUS-WARNING: Virus Scanner does not fetch signatures when opened"
else
    echo "FABULOUS-WARNING: Virus Scanner menu entry not found"
fi
chmod 0755 /usr/local/bin/fabulous-virus-scanner /usr/local/sbin/fabulous-stick-session
systemctl enable fabulous-stick-session.service || echo "FABULOUS-WARNING: internal disks are NOT protected in the stick session"

# Self-check used by the build servers' test machines (see the script for when it runs).
chmod 0755 /usr/local/sbin/fabulous-selftest
systemctl enable fabulous-selftest.service || echo "FABULOUS-WARNING: self-check not enabled"

apt-get clean
